```{=html}
<%
/* Card grid for articles and guide articles.
   template-params: heading (2 or 3, to keep heading order), empty (text shown before the first item). */
const p = (typeof templateParams !== 'undefined' && templateParams) ? templateParams : {};
const h = p.heading || 2;
const topics = ['AI', 'AI control plane', 'Data science', 'Statistics', 'Machine learning', 'Python'];
const levels = ['Beginner', 'Intermediate', 'Advanced'];
const chipClass = (c) => topics.includes(c) ? 'ai-chip ai-chip-topic' : (levels.includes(c) ? 'ai-chip ai-chip-level' : 'ai-chip');
%>
<% if (items.length === 0) { %>
<div class="ai-empty"><p><%= p.empty || 'Nothing here yet.' %></p></div>
<% } %>
<ul class="list ai-cards">
<% for (const item of items) { %>
<li class="ai-card" <%= metadataAttrs(item) %>>
<a class="ai-card-link" href="<%- item.path %>">
<% if (item.image) { %><img src="<%- item.image %>" alt="" loading="lazy" width="1200" height="630"><% } %>
<div class="ai-card-body">
<h<%= h %> class="listing-title"><%= item.title %></h<%= h %>>
<% if (item.description) { %><p class="listing-description"><%= item.description %></p><% } %>
<p class="ai-meta"><span class="listing-date"><%= item.date %></span><% if (item['reading-time']) { %> · <span class="ai-reading" data-path="<%- item.path %>"><%= item['reading-time'] %></span><% } %></p>
<% if (item.source) { %><p class="ai-source">Source: <%= item.source %></p><% } %>
<% if (item.categories && item.categories.length) { %><p class="ai-chips"><% for (const c of item.categories) { %><span class="<%= chipClass(c) %>"><%= c %></span><% } %></p><% } %>
</div>
</a>
</li>
<% } %>
</ul>
```
